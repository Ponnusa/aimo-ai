# EXAMPLE ONLY. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_network
REGISTRY_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_registry
BUYER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_buyer
SUPPLIER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_supplier
REDIS_URL=redis://localhost:6379/0
NETWORK_API_URL=http://localhost:8000
REGISTRY_API_URL=http://localhost:8003
BUYER_A2A_URL=http://localhost:8001
SUPPLIER_A2A_URL=http://localhost:8002
# Each agent's own identity (M1: used on its Agent Card; cryptographic
# organization-ownership binding for agent *management* is M2 -- see
# SERVICE_CREDENTIAL_SIGNING_SECRET below. Agent-to-human organization
# identity itself is still self-declared config, not OIDC-verified; that
# is a later milestone).
BUYER_AGENT_ID=agent_fictional_buyer_01
BUYER_ORGANIZATION_ID=org_fictional_bistro_01
SUPPLIER_AGENT_ID=agent_fictional_supplier_01
SUPPLIER_ORGANIZATION_ID=org_fictional_wholesale_01
# M2: network-api issues short-lived, organization-scoped service
# credentials (packages/identity) that registry-api verifies locally.
# Both services MUST be configured with the exact same value here.
SERVICE_CREDENTIAL_SIGNING_SECRET=dev-only-signing-secret-change-me
# M2: shared secrets for network-api's own admin/internal endpoints.
# NETWORK_ADMIN_API_KEY stands in for human-approved org administration
# (no OIDC/human approval flow exists until M6/M7). NETWORK_INTERNAL_SERVICE_KEY
# is for registry-api's read-only relationship lookup only -- never expose
# either of these to the public internet.
NETWORK_ADMIN_API_KEY=dev-only-admin-key-change-me
NETWORK_INTERNAL_SERVICE_KEY=dev-only-internal-key-change-me
# M2 SSRF defense: registry-api fetches operator-supplied Agent Card URLs
# and rejects private/loopback/link-local/metadata-service targets by
# default. Set this to "true" ONLY for local dev/test, where
# buyer-agent/supplier-agent run on 127.0.0.1 -- it MUST remain unset/false
# in any real deployment. See docs/DECISIONS.md ADR-008.
REGISTRY_ALLOW_PRIVATE_NETWORK_CARD_TARGETS=true
OPA_URL=http://localhost:8181
LLM_PROVIDER=fake
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OBJECT_STORAGE_BUCKET=
# Use Railway/Vercel secrets or an approved secret manager in deployed environments.
