# EXAMPLE ONLY. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_network
REGISTRY_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_registry
BUYER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_buyer
SUPPLIER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_supplier
BUYER_MCP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_buyer_mcp
SUPPLIER_MCP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aimo_supplier_mcp
REDIS_URL=redis://localhost:6379/0
NETWORK_API_URL=http://localhost:8000
REGISTRY_API_URL=http://localhost:8003
BUYER_A2A_URL=http://localhost:8001
SUPPLIER_A2A_URL=http://localhost:8002
BUYER_MCP_URL=http://localhost:8004/mcp
SUPPLIER_MCP_URL=http://localhost:8005/mcp
# Each agent's own identity (M1: used on its Agent Card; cryptographic
# organization-ownership binding for agent *management* is M2 -- see
# SERVICE_CREDENTIAL_SIGNING_SECRET below. Agent-to-human organization
# identity itself is still self-declared config, not OIDC-verified; that
# is a later milestone).
BUYER_AGENT_ID=agent_fictional_buyer_01
BUYER_ORGANIZATION_ID=org_fictional_bistro_01
SUPPLIER_AGENT_ID=agent_fictional_supplier_01
SUPPLIER_ORGANIZATION_ID=org_fictional_wholesale_01
# M3: the one organization each MCP tool server exclusively serves. A
# service credential scoped to any other organization is rejected.
BUYER_MCP_ORGANIZATION_ID=org_fictional_bistro_01
SUPPLIER_MCP_ORGANIZATION_ID=org_fictional_wholesale_01
# M3: pre-minted, scoped "use_buyer_tools"/"use_supplier_tools" service
# credentials for each agent to call its own org's MCP tool server. Mint
# via network-api's /organizations/{id}/service-credentials (scope
# "use_buyer_tools" or "use_supplier_tools") -- the agent process itself
# never holds NETWORK_ADMIN_API_KEY.
BUYER_MCP_SERVICE_CREDENTIAL=
SUPPLIER_MCP_SERVICE_CREDENTIAL=
# M2: network-api issues short-lived, organization-scoped service
# credentials (packages/identity) that registry-api/buyer-mcp/supplier-mcp
# verify locally. Every service MUST be configured with the exact same
# value here.
SERVICE_CREDENTIAL_SIGNING_SECRET=dev-only-signing-secret-change-me
# M2: shared secrets for network-api's own admin/internal endpoints.
# NETWORK_ADMIN_API_KEY stands in for human-approved org administration
# (no OIDC/human approval flow exists until M6/M7). NETWORK_INTERNAL_SERVICE_KEY
# is for registry-api's read-only relationship lookup only -- never expose
# either of these to the public internet.
NETWORK_ADMIN_API_KEY=dev-only-admin-key-change-me
NETWORK_INTERNAL_SERVICE_KEY=dev-only-internal-key-change-me
# M2 SSRF defense: registry-api fetches operator-supplied Agent Card URLs
# and rejects private/loopback/link-local/metadata-service targets by
# default. Set this to "true" ONLY for local dev/test, where
# buyer-agent/supplier-agent run on 127.0.0.1 -- it MUST remain unset/false
# in any real deployment. See docs/DECISIONS.md ADR-008.
REGISTRY_ALLOW_PRIVATE_NETWORK_CARD_TARGETS=true
OPA_URL=http://localhost:8181
LLM_PROVIDER=fake
OBJECT_STORAGE_BUCKET=

# M5.1: each organization's own Ed25519 private key (PEM) and kid, used
# to sign every negotiation/authorization/commitment artifact. Generate
# with scripts/generate_signing_key.py and register the printed public
# JWK with network-api's /organizations/{id}/signing-keys -- network-api
# never receives or stores the private half.
BUYER_SIGNING_PRIVATE_KEY_PEM=
BUYER_SIGNING_KID=
SUPPLIER_SIGNING_PRIVATE_KEY_PEM=
SUPPLIER_SIGNING_KID=

# M6: each agent's own additive /management API, called only by the
# portal, with a "manage_organization"-scoped credential it mints
# per request from network-api -- same shared signing secret and
# internal-service key as every other intra-organization scope above.
PORTAL_ORGANIZATION_ID=org_aimo_portal
BUYER_REQUIRE_SECOND_APPROVER_ABOVE_AMOUNT=
SUPPLIER_REQUIRE_SECOND_APPROVER_ABOVE_AMOUNT=

# M6 portal (apps/portal). PORTAL_ENVIRONMENT gates the development
# login adapter exactly like identity.dev_oidc -- never "local"/
# "staging"/"test" in a real deployment. PORTAL_PUBLIC_URL must be the
# portal's own real, externally-reachable origin (Next.js does not
# trust the inbound Host header for self-referential redirects). The
# portal's own Ed25519 keypair is generated and registered the same way
# as an organization's (against PORTAL_ORGANIZATION_ID above).
PORTAL_ENVIRONMENT=local
PORTAL_PUBLIC_URL=http://localhost:3000
PORTAL_DATABASE_PATH=./portal.sqlite3
PORTAL_SIGNING_PRIVATE_KEY_PEM=
PORTAL_SIGNING_KID=
BUYER_AGENT_URL=http://localhost:8001
SUPPLIER_AGENT_URL=http://localhost:8002
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Use Railway/Vercel secrets or an approved secret manager in deployed environments.
