{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aimobrain.example/food-wholesale/order_confirmation/v0.1",
  "title": "Food Wholesale Order Confirmation",
  "description": "Supplier's response to an order_commit_request, from its own mock order adapter. status=CONFIRMED is the exact point the simulated transaction becomes binding (docs/DECISIONS.md M5); status=FAILED or RECONCILIATION_REQUIRED mean it is not.",
  "type": "object",
  "required": [
    "schema",
    "artifact_id",
    "transaction_id",
    "correlation_id",
    "sender_agent_id",
    "recipient_agent_id",
    "organization_id",
    "domain",
    "type",
    "version",
    "proposal_id",
    "created_at",
    "expires_at",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "sender_agent_id": {
      "type": "string"
    },
    "recipient_agent_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "domain": {
      "const": "food-wholesale"
    },
    "type": {
      "const": "order_confirmation"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "agreement_id",
        "idempotency_key",
        "status",
        "external_order_id"
      ],
      "properties": {
        "agreement_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "FAILED",
            "RECONCILIATION_REQUIRED"
          ]
        },
        "external_order_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "proof": {
      "type": "object",
      "description": "Per-artifact JWS signature (M5.1, docs/DECISIONS.md ADR-012): the sender organization's Ed25519 signature over this artifact's canonicalized content plus iss/sub/aud/neg/typ/ver/hash/jti/exp claims. message_integrity.verify_artifact_proof requires its presence and validity before any business handler runs -- optional here because JSON Schema validates structure, not authentication.",
      "required": [
        "alg",
        "kid",
        "jws"
      ],
      "properties": {
        "alg": {
          "const": "EdDSA"
        },
        "kid": {
          "type": "string"
        },
        "jws": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
