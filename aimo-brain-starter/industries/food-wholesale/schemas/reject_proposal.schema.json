{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aimobrain.example/food-wholesale/reject_proposal/v0.1",
  "title": "Food Wholesale Reject Proposal",
  "description": "Explicit, terminal rejection or cancellation of a negotiation by either party.",
  "type": "object",
  "required": [
    "schema",
    "artifact_id",
    "transaction_id",
    "correlation_id",
    "sender_agent_id",
    "recipient_agent_id",
    "organization_id",
    "domain",
    "type",
    "version",
    "proposal_id",
    "created_at",
    "expires_at",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "sender_agent_id": {
      "type": "string"
    },
    "recipient_agent_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "domain": {
      "const": "food-wholesale"
    },
    "type": {
      "const": "reject_proposal"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "rejected_proposal_id",
        "reason"
      ],
      "properties": {
        "rejected_proposal_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "proof": {
      "type": "object",
      "description": "Per-artifact JWS signature (M5.1, docs/DECISIONS.md ADR-012): the sender organization's Ed25519 signature over this artifact's canonicalized content plus iss/sub/aud/neg/typ/ver/hash/jti/exp claims. message_integrity.verify_artifact_proof requires its presence and validity before any business handler runs -- optional here because JSON Schema validates structure, not authentication.",
      "required": [
        "alg",
        "kid",
        "jws"
      ],
      "properties": {
        "alg": {
          "const": "EdDSA"
        },
        "kid": {
          "type": "string"
        },
        "jws": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
