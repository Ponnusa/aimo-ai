{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aimobrain.example/food-wholesale/accept_proposal/v0.1",
  "title": "Food Wholesale Accept Proposal",
  "description": "Sent by whichever party agrees to the counterparty's exact last offer. Binds to one specific proposal_id and content_hash — never a vague acceptance.",
  "type": "object",
  "required": [
    "schema",
    "artifact_id",
    "transaction_id",
    "correlation_id",
    "sender_agent_id",
    "recipient_agent_id",
    "organization_id",
    "domain",
    "type",
    "version",
    "proposal_id",
    "created_at",
    "expires_at",
    "payload"
  ],
  "properties": {
    "schema": { "type": "string" },
    "artifact_id": { "type": "string" },
    "transaction_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "sender_agent_id": { "type": "string" },
    "recipient_agent_id": { "type": "string" },
    "organization_id": { "type": "string" },
    "domain": { "const": "food-wholesale" },
    "type": { "const": "accept_proposal" },
    "version": { "type": "integer", "minimum": 2 },
    "proposal_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["accepted_proposal_id", "accepted_content_hash"],
      "properties": {
        "accepted_proposal_id": {
          "type": "string",
          "description": "The exact proposal_id (quote or counterproposal) being accepted as-is."
        },
        "accepted_content_hash": {
          "type": "string",
          "description": "Must equal the recipient's own recorded content_hash for accepted_proposal_id, or the accept is rejected as a stale/mismatched reference."
        }
      }
    }
  },
  "additionalProperties": true
}
